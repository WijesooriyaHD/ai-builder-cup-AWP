<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="com.android.vending.BILLING"/>
    <!-- Microphone: Premium voice "Conversation Mode" (Gemini Live) captures
         audio for real-time conversation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Health Connect: read sleep for the Sleep Coach (no writes). -->
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <application
        android:label="AIWellnessPal"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Deep link for widget "Check In" button -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aiwellnesspal" android:host="checkin" />
            </intent-filter>
            <!-- Health Connect permission rationale (Android 14+). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Health Connect permission rationale (Android 13 and below). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        
        <receiver android:name=".IntentionWidget" android:exported="true"
            android:label="@string/intention_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/intention_widget_info" />
        </receiver>

        <receiver android:name=".AIWellnessWidget" android:exported="true"
            android:label="@string/ai_wellness_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/ai_wellness_widget_info" />
        </receiver>

        <receiver android:name=".HabitWidget" android:exported="true"
            android:label="@string/habit_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>

        <!-- Life-toolkit shortcut widgets (square, tap to open the tool). -->
        <receiver android:name=".NutritionToolWidget" android:exported="true"
            android:label="@string/tool_widget_nutrition_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/nutrition_tool_widget_info" />
        </receiver>
        <receiver android:name=".MealPlannerToolWidget" android:exported="true"
            android:label="@string/tool_widget_meal_planner_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/meal_planner_tool_widget_info" />
        </receiver>
        <receiver android:name=".CalorieBudgetToolWidget" android:exported="true"
            android:label="@string/tool_widget_calorie_budget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/calorie_budget_tool_widget_info" />
        </receiver>
        <receiver android:name=".HydrationToolWidget" android:exported="true"
            android:label="@string/tool_widget_hydration_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/hydration_tool_widget_info" />
        </receiver>
        <receiver android:name=".SleepToolWidget" android:exported="true"
            android:label="@string/tool_widget_sleep_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/sleep_tool_widget_info" />
        </receiver>
        <receiver android:name=".MeditationToolWidget" android:exported="true"
            android:label="@string/tool_widget_meditation_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/meditation_tool_widget_info" />
        </receiver>
        <receiver android:name=".PeriodTrackerToolWidget" android:exported="true"
            android:label="@string/tool_widget_period_tracker_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/period_tracker_tool_widget_info" />
        </receiver>
        <receiver android:name=".WeightTrackerToolWidget" android:exported="true"
            android:label="@string/tool_widget_weight_tracker_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/weight_tracker_tool_widget_info" />
        </receiver>
        <receiver android:name=".MindfulTravelToolWidget" android:exported="true"
            android:label="@string/tool_widget_mindful_travel_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/mindful_travel_tool_widget_info" />
        </receiver>

        <!-- Re-renders widgets just after midnight and on clock/timezone
             changes, boot and app updates (see MidnightWidgetRefresh.kt). -->
        <receiver android:name=".MidnightWidgetRefresh" android:exported="false">
            <intent-filter>
                <action android:name="com.aiwellnesspal.app.WIDGET_MIDNIGHT" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- flutter_local_notifications scheduling receivers.
             Since plugin v16 these are NOT declared by the plugin, so the app has
             to register them. ScheduledNotificationReceiver is what AlarmManager
             fires to actually display a scheduled notification — without it every
             zonedSchedule() reminder silently never appears. The boot receiver
             re-arms pending schedules after a restart. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver android:name="es.antonborri.home_widget.HomeWidgetBackgroundReceiver" android:exported="true">
            <intent-filter>
                <action android:name="es.antonborri.home_widget.action.BACKGROUND" />
            </intent-filter>
        </receiver>

        <service android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets habit / Today's Plan reminders fire at the exact time chosen
         (Android 12+; the user can grant it under "Alarms & reminders").
         Without it reminders fall back to inexact timing and can arrive late.
         USE_EXACT_ALARM is deliberately not used: Play restricts it to alarm
         and calendar apps. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets flutter_local_notifications reschedule pending reminders after a
         reboot. Without it every scheduled notification is dropped on restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="instagram" />
        </intent>
        <!-- Health Connect app (for availability check + launching settings). -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Speech recognition service (speech_to_text). Without this, Android
             11+ package visibility hides the recognizer and every device
             reports recognizerNotAvailable. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>
