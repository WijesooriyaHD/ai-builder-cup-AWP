<?xml version="1.0" encoding="utf-8"?>
<!-- Meal Planner widget, flipped face: today's meal card with up/down arrows to
     browse meals, mirroring iOS. See MealPlannerToolWidget.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tool_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="22dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meal_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textAllCaps="true"
                android:textColor="#FFEF8354"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meal_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="3"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meal_cal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meal_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.6"
                android:gravity="center"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_text"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/meal_prev"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_arrow_bg"
                android:contentDescription="Previous meal"
                android:padding="4dp"
                android:src="@drawable/ic_meal_prev" />

            <ImageView
                android:id="@+id/meal_next"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/widget_arrow_bg"
                android:contentDescription="Next meal"
                android:padding="4dp"
                android:src="@drawable/ic_meal_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- Flip back to the tool tile (see WidgetFlip.kt). -->
    <ImageView
        android:id="@+id/flip_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:padding="4dp"
        android:contentDescription="Flip back"
        android:src="@drawable/ic_widget_flip"
        android:visibility="gone" />

    <!-- Per-widget light/dark toggle (see WidgetTheme.kt). -->
    <ImageView
        android:id="@+id/theme_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:padding="4dp"
        android:contentDescription="Switch light or dark theme"
        android:src="@drawable/ic_widget_theme" />
</FrameLayout>
