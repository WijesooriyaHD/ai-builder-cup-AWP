<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_gradient"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: icon + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/h_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="📋"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/h_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today's Habits"
            android:textColor="@color/widget_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Empty state -->
    <TextView
        android:id="@+id/h_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:text="No habits for today. Open the app to add some."
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Habit row 1 -->
    <LinearLayout
        android:id="@+id/h_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="14dp"
        android:paddingBottom="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row1_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/h_row1_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="16sp" />
        <TextView
            android:id="@+id/h_row1_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Habit row 2 -->
    <LinearLayout
        android:id="@+id/h_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row2_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/h_row2_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="16sp" />
        <TextView
            android:id="@+id/h_row2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Habit row 3 -->
    <LinearLayout
        android:id="@+id/h_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row3_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/h_row3_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="16sp" />
        <TextView
            android:id="@+id/h_row3_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Habit row 4 -->
    <LinearLayout
        android:id="@+id/h_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row4_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/h_row4_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="16sp" />
        <TextView
            android:id="@+id/h_row4_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Progress section -->
    <TextView
        android:id="@+id/h_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:text="0 of 0 done"
        android:textColor="@color/widget_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/h_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_primary"
        android:visibility="gone" />

</LinearLayout>
