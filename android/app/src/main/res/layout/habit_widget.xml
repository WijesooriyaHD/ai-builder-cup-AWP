<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_todays_habits"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: icon + title (no chip) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/h_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="📋"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/h_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Today's Habits"
            android:textColor="@color/widget_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- Per-widget light/dark toggle (see WidgetTheme.kt). -->
        <ImageView
            android:id="@+id/theme_toggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:contentDescription="Switch light or dark theme"
            android:src="@drawable/ic_widget_theme" />
    </LinearLayout>

    <!-- Empty state chip -->
    <TextView
        android:id="@+id/h_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="No habits for today. Open the app to add some."
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Habit row 1 -->
    <LinearLayout
        android:id="@+id/h_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row1_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/h_row1_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="15sp" />
        <TextView
            android:id="@+id/h_row1_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Habit row 2 -->
    <LinearLayout
        android:id="@+id/h_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_row2_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="18sp" />
        <TextView
            android:id="@+id/h_row2_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text=""
            android:textSize="15sp" />
        <TextView
            android:id="@+id/h_row2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Progress (no chip) -->
    <LinearLayout
        android:id="@+id/h_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/h_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:text="0 of 0 done"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
        <ProgressBar
            android:id="@+id/h_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_primary" />
    </LinearLayout>

</LinearLayout>
