<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tool_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/tool_bg_hydration"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/hydration_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧"
            android:textColor="@color/widget_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hydration_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Hydration Coach"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/hydration_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/hydration_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Hydration Coach"
            android:textColor="@color/widget_text"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Flip between the tool tile and its live-data face (see WidgetFlip.kt).
         Hidden by default; only the data-capable tool widgets show it. -->
    <ImageView
        android:id="@+id/flip_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|start"
        android:layout_margin="2dp"
        android:padding="4dp"
        android:contentDescription="Flip to see today's details"
        android:src="@drawable/ic_widget_flip"
        android:visibility="gone" />

    <!-- Per-widget light/dark toggle (see WidgetTheme.kt). Overlays the
         tile's top-right corner; taps here don't reach tool_root's launch. -->
    <ImageView
        android:id="@+id/theme_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="2dp"
        android:padding="4dp"
        android:contentDescription="Switch light or dark theme"
        android:src="@drawable/ic_widget_theme" />
</FrameLayout>
