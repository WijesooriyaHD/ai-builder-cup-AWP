<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tool_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tool_bg_hydration"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/hydration_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💧"
        android:textColor="@color/widget_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hydration_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Hydration Coach"
        android:textColor="@color/widget_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/hydration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/hydration_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="Hydration Coach"
        android:textColor="@color/widget_text"
        android:textSize="10sp" />
</LinearLayout>
