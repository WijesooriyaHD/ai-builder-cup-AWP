<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_todays_plan"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: icon + focus title (no chip) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:text="✨"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/wellness_focus_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Today's Focus"
            android:textColor="@color/widget_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- Per-widget light/dark toggle (see WidgetTheme.kt). -->
        <ImageView
            android:id="@+id/theme_toggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:contentDescription="Switch light or dark theme"
            android:src="@drawable/ic_widget_theme" />
    </LinearLayout>

    <!-- Placeholder chip (shown when no data) -->
    <TextView
        android:id="@+id/placeholder_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="Open the app to start your wellness day."
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Task row 1 chip -->
    <LinearLayout
        android:id="@+id/w_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_row1_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/w_row1_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Task row 2 chip -->
    <LinearLayout
        android:id="@+id/w_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/w_row2_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="12dp"
            android:text="☐"
            android:textColor="@color/widget_primary"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/w_row2_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/widget_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Progress (no chip) -->
    <LinearLayout
        android:id="@+id/w_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/w_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:text="0 of 0 actions"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
        <ProgressBar
            android:id="@+id/w_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_primary" />
    </LinearLayout>

</LinearLayout>
