<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AI Wellness Pal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AIWellnessPal</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.aiwellnesspal.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aiwellnesspal</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.850061163183-df40a72toaqlo9d7us7mntfqrs3ckh68</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram</string>
		<string>https</string>
		<string>http</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>We need access to your camera so you can take a profile picture and snap meal photos for the AI Nutrition Coach.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>AI Wellness Pal reads your sleep data so the Sleep Coach can show your sleep score, stages, and personalized recovery insights.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>AI Wellness Pal does not write to Health; this permission is only requested by the system alongside reading your sleep data.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>AI Wellness Pal only uses your location if you choose to center the map on where you are. Place search works without it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AI Wellness Pal needs microphone access for voice commands and conversational check-ins.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need access to your photo library so you can upload a profile picture and analyze food photos with the AI Nutrition Coach.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AI Wellness Pal uses speech recognition to let you interact with your wellness assistant using your voice.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
